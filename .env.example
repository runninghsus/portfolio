# Copy to .env.local for local development; set the same names in Vercel → Settings → Environment Variables.
ANTHROPIC_API_KEY=            # required for the "Ask about my work" assistant (console.anthropic.com)
CHAT_MODEL=claude-haiku-4-5   # optional; any current Claude model id
# Optional, recommended once live: shared rate limits via Upstash Redis (free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CHAT_DAILY_PER_IP=40
CHAT_DAILY_GLOBAL=1500
